{
  "name": "@chaos-design/slack",
  "version": "0.0.1",
  "private": true,
  "description": "A React knowledge library for AI Agent studies and self-contained HTML slide decks.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://slack.chaosmic.cn/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaos-design/slack.git"
  },
  "bugs": {
    "url": "https://github.com/chaos-design/slack/issues"
  },
  "keywords": [
    "ai-agent",
    "react",
    "vite",
    "knowledge-base",
    "bilingual-reader",
    "html-slides"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "verify:studies": "node scripts/verify-studies.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.28.0"
    }
  },
  "packageManager": "pnpm@10.18.1"
}
